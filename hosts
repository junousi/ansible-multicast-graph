[core]
# Inject to /etc/hosts
rtr1 os=junos ansible_host=192.168.122.101 ansible_user=admin
rtr2 os=junos ansible_host=192.168.122.102 ansible_user=admin
rtr3 os=junos ansible_host=192.168.122.103 ansible_user=admin

[all:vars]
ansible_python_interpreter="/usr/bin/env python3"
show_lag_cmd="show lacp interfaces"
show_rps_cmd="show pim rps"
show_interface_cmd='show interfaces terse|match "inet "'
show_mroute_cmd="show multicast route group"
show_snooping_cmd="show igmp snooping membership"
show_lldp_cmd="show lldp neighbors detail|no-more"

